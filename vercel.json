{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["frontend/**"]
      }
    },
    {
      "src": "api/ai.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["ai/**", "config/**", "requirements.txt"]
      }
    }
  ],
  "routes": [
    { "src": "/api/ai(.*)", "dest": "/api/ai.py" },
    { "src": "/core/(.*)", "dest": "/frontend/core/$1" },
    { "src": "/components/(.*)", "dest": "/frontend/components/$1" },
    { "src": "/pages/(.*)", "dest": "/frontend/pages/$1" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
