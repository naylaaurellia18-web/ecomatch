# Environment variables untuk lokal (opsional)
# Prioritas database: DATABASE_URL (PostgreSQL+PostGIS) > TURSO_DATABASE_URL (libSQL) > SQLite lokal data/food_rescue.db

# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# ========= SESUAI SKPL: PostgreSQL + PostGIS & AI Matching Python =========
# Aktifkan DATABASE_URL -> backend memakai PostgreSQL (ekstensi PostGIS dibuat otomatis).
# Contoh Docker (lihat docker-compose.yml): docker compose up -d
# DATABASE_URL=postgresql://postgres:foodrescue@127.0.0.1:5433/food_rescue

# Layanan AI Matching Python (npm run start:ai). Tanpa ini / bila gagal, mesin JavaScript dipakai.
# AI_MATCHING_URL=http://127.0.0.1:8001

# Rute jalan raya (NFR-06) via OSRM; set ROUTE_PROVIDER=haversine untuk mode luring.
# ROUTE_PROVIDER=osrm
# OSRM_BASE_URL=https://router.project-osrm.org
# OSRM_TIMEOUT_MS=2500

# ========= WAJIB DI PRODUKSI (Vercel / Railway) =========
# NODE_ENV=production
# JWT_SECRET=<32+ karakter acak>   # wajib; app GAGAL start tanpa ini di produksi
# ADMIN_EMAIL=admin@domainanda.id  # admin pertama saat DB kosong
# ADMIN_PASSWORD=<min 12 karakter> # hanya dipakai saat seed admin pertama
# ADMIN_NAME=Admin EcoMatch

# ========= OPSIONAL =========
# ALLOW_DEMO_ACCOUNTS=1            # IZINKAN akun demo di produksi (TIDAK disarankan)
# ALLOW_FORCE_SEED_PRODUCTION=1    # izinkan seed --force di produksi (hapus semua user!)
# ALLOWED_ORIGINS=https://a.vercel.app,https://b.vercel.app  # CORS allowlist (frontend terpisah); kosong = same-origin only

# --- Lupa sandi: tanpa SMTP, kode hanya muncul di outbox admin ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# MAIL_FROM="EcoMatch <you@gmail.com>"
# NOTIFY_EMAIL=you@gmail.com

# --- Foto ke Cloudinary (disarankan di produksi; tanpa env -> base64 di DB) ---
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_FOLDER=ecomatch

# --- Notifikasi WhatsApp (CallMeBot, gratis - hanya untuk demo) ---
# Dapatkan APIKEY: simpan nomor CallMeBot di kontak HP, kirim "I allow callmebot to send me messages"
# CALLMEBOT_APIKEY=123456

# --- Gateway WhatsApp lain (produksi: gunakan provider resmi) ---
# WHATSAPP_API_URL=https://...
# WHATSAPP_API_TOKEN=...

# Buat JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
