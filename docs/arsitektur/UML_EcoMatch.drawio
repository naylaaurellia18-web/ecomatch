<diagram id="class-backend-eco-match" name="class-backend-eco-match"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1670" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5_c_AuthService" value="&lt;b&gt;AuthService&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+register(data) User&lt;br/&gt;+login(email, password) Token&lt;br/&gt;+forgotPassword(email)&lt;br/&gt;+resetPassword(kode, sandiBaru)&lt;br/&gt;+authenticate(token) User&lt;br/&gt;-hashPassword(sandi) String&lt;br/&gt;-signToken(user) String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="250" height="146" as="geometry"/></mxCell><mxCell id="p5_c_User" value="&lt;b&gt;User&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+int id_user&lt;br/&gt;+string nama&lt;br/&gt;+string email&lt;br/&gt;+string password&lt;br/&gt;+enum role &amp;quot;donor_mbg|tps_pengolah|kurir|admin&amp;quot;&lt;br/&gt;+enum status&lt;br/&gt;+float lat&lt;br/&gt;+float lng" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="250" height="162" as="geometry"/></mxCell><mxCell id="p5_c_ProfilMBG" value="&lt;b&gt;ProfilMBG&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+int id_user PK&lt;br/&gt;+string nama_sppg&lt;br/&gt;+string alamat&lt;br/&gt;+float lat&lt;br/&gt;+float lng&lt;br/&gt;+int kapasitas_porsi_harian&lt;br/&gt;+string penanggung_jawab&lt;br/&gt;+string kontak&lt;br/&gt;+string npwp" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="250" height="178" as