{
  "name": "ecomatch",
  "version": "1.0.0",
  "description": "EcoMatch — AI Routing Sampah Makanan MBG ke TPS Pengolah (Kota Madiun), PWA + WhatsApp/Email gateway",
  "main": "backend/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node backend/index.js",
    "start:local": "node --env-file-if-exists=.env backend/index.js",
    "dev": "node --env-file-if-exists=.env --watch backend/index.js",
    "seed": "node backend/seed.js",
    "seed:local": "node --env-file-if-exists=.env backend/seed.js",
    "seed:accounts": "node backend/seed.js --force --accounts",
    "clean": "node backend/seed.js --clean",
    "start:ai": "python -m uvicorn main:app --host 127.0.0.1 --port 8001 --app-dir ai",
    "test:e2e": "node e2e-test.js"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.1"
  }
}
